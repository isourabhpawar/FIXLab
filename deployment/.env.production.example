# FixLab production environment — copy to .env.production and edit.
# Used as: docker compose --env-file deployment/.env.production up -d --build
# Every FIXLAB_* variable the backend reads is listed below. Anything marked
# TEST ONLY must never be set in production.

# ── Identity ──────────────────────────────────────────────────────────
# Hostname advertised to FIX clients in session endpoint details.
# MUST be the real public hostname (or IP) clients dial.
FIXLAB_PUBLIC_HOST=fixlab.example.com

# REST API listen address inside the container.
FIXLAB_HTTP_ADDR=:8080

# ── Session lifecycle ─────────────────────────────────────────────────
# How long a sandbox lives before automatic destruction.
FIXLAB_SESSION_TTL=4h
# How often the expiry worker reaps dead sessions.
FIXLAB_CLEANUP_INTERVAL=60s

# ── FIX port pool ─────────────────────────────────────────────────────
# Acceptor sessions each consume one TCP port from this pool.
# MUST match the published port range in docker-compose.yml
# (default 10000-10099 ≈ 100 concurrent ACCEPTOR sessions;
# widen both together, e.g. 10000-20000, for capacity).
FIXLAB_PORT_MIN=10000
FIXLAB_PORT_MAX=10099

# Where the QuickFIX/Go acceptor binds internally. Keep loopback-only:
# the public listener is the guard proxy (rate limiting, timeouts,
# frame-size enforcement). No reason to change this in production.
FIXLAB_INTERNAL_BIND=127.0.0.1

# ── Quotas (spec §4) ──────────────────────────────────────────────────
# Application messages per session; outbound executions past the limit
# are refused with 429. Admin messages (A,0,1,2,4,5) never count.
FIXLAB_APP_MSG_LIMIT=250
# Bounded per-session message history (ring buffer).
FIXLAB_MSG_HISTORY_CAP=500
# Max orders on the blotter per session.
FIXLAB_ORDER_CAP=1000
# Concurrent active sessions per client IP (spec §44). Past the limit,
# session creation returns 429. Raise deliberately if one NAT-ed office
# creates many sandboxes.
FIXLAB_MAX_SESSIONS_PER_IP=1

# ── FIX session protection (spec §41, §43) ────────────────────────────
# Minimum HeartBtInt (tag 108) accepted on logon; lower is dropped.
FIXLAB_MIN_HEARTBEAT_INT=10
# Max FIX frame bytes; larger frames are dropped.
FIXLAB_MAX_FIX_FRAME=8192
# Idle TCP connections are closed after this long.
FIXLAB_TCP_IDLE_TIMEOUT=5m
# Grace period for the first logon after TCP connect.
FIXLAB_TCP_LOGON_TIMEOUT=30s
# Inbound FIX connection attempts per minute per IP.
FIXLAB_TCP_CONN_RATE_PER_MIN=5

# ── HTTP protection (spec §41) ────────────────────────────────────────
# API/WebSocket requests per hour per IP.
FIXLAB_HTTP_RATE_PER_HOUR=10000
# Max HTTP request body bytes (dictionary uploads cap at 512 KiB
# inside this; the HTTP layer caps at 1 MiB regardless).
FIXLAB_HTTP_MAX_BODY=1048576
# Access-Control-Allow-Origin for the API and WebSocket.
# LOCK THIS DOWN to your exact frontend origin in production.
FIXLAB_CORS_ORIGIN=https://fixlab.example.com

# ── Initiator (outbound FIX, spec §9) ──────────────────────────────────
# Dial+logon budget; expiry without logon -> CONNECTION_FAILED, dialing stops.
FIXLAB_INITIATOR_CONNECT_TIMEOUT=10s
# Max concurrent initiator sessions per server.
FIXLAB_INITIATOR_MAX_OUTBOUND=50
# Outbound dial attempts per minute per destination IP.
FIXLAB_INITIATOR_DIAL_RATE_PER_MIN=10
# Timeout for the SSRF DNS-resolution step.
FIXLAB_INITIATOR_DNS_TIMEOUT=5s

# ── TLS (spec §15) ────────────────────────────────────────────────────
# PEM certificate + key for edge TLS termination on "tls": true sessions.
# Mount your real certs (e.g. Let's Encrypt) and point here:
#   volumes: ["./certs:/certs:ro"]
FIXLAB_TLS_CERT=/certs/fixlab.crt
FIXLAB_TLS_KEY=/certs/fixlab.key
# Initiator-side: skip verifying the REMOTE counterparty's certificate.
# TEST ONLY — never enable in production.
#FIXLAB_TLS_INSECURE_SKIP_VERIFY=false

# ── Danger switches (TEST ONLY — never set in production) ────────────
# Bypasses private-range SSRF blocking so the acceptance suite can dial
# a 127.0.0.1 counterparty. Enabling this in production lets initiator
# sessions reach 127/8, 10/8, 172.16/12, 192.168/16, 169.254/16 and
# cloud metadata endpoints.
#FIXLAB_TEST_ALLOW_PRIVATE=true

# ── Debugging ─────────────────────────────────────────────────────────
# Set to 1 to log every FIX message (very noisy — never leave on).
#FIXLAB_LOG_FIX_MESSAGES=1

# ── MCP server (only if you run bin/mcp-server separately) ───────────
# Base URL of the FixLab backend the MCP server wraps.
#FIXLAB_API_URL=http://127.0.0.1:8080
